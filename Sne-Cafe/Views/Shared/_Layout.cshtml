@{
    var path = (Context.Request.Path.Value ?? "/").ToLower();
    var onOrders = path == "/" || path.StartsWith("/home");
    var onNew = path.StartsWith("/order/create");
    var onStaff = path.StartsWith("/account/staff");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SNE Cafe</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg sne-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-hearts"></i> SNÉ CAFE
            </a>

            @if (signedIn)
            {
                <ul class="navbar-nav ms-auto flex-row flex-wrap align-items-center gap-3">
                    <li class="nav-item">
                        <a class="nav-link @(onNew ? "active" : "")" asp-controller="Order" asp-action="Create">
                            <i class="bi bi-bag-plus"></i> New Order
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(onOrders ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-list-check"></i> Orders
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(onStaff ? "active" : "")" asp-controller="Account" asp-action="Staff">
                                <i class="bi bi-people"></i> Staff
                            </a>
                        </li>
                    }
                    <li class="nav-item text-muted small">
                        <i class="bi bi-person-circle"></i> @User.Identity!.Name
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-light">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            }
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>