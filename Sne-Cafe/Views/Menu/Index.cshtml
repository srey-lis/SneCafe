@using SneCafe.Models
@model List<MenuRow>
@{
    ViewData["Title"] = "Menu";
}

<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Menu</h1>
        <p class="text-muted mb-0">Add, edit and remove the items staff can sell.</p>
    </div>
    <a asp-action="Create" class="btn btn-sne px-4">
        <i class="bi bi-plus-lg me-1"></i> Add Item
    </a>
</div>

@if (TempData["Info"] != null)
{
    <div class="alert alert-success">@TempData["Info"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">

    <!-- Items -->
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase small text-muted">
                            <th class="ps-4">Item</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="@(r.IsAvailable ? "" : "text-muted")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="cart-thumb">
                                            <i class="bi @r.Icon"></i>
                                            @if (!string.IsNullOrEmpty(r.ImageUrl))
                                            {
                                                <img src="@r.ImageUrl" alt="" onerror="this.remove()">
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@r.Name</div>
                                            <div class="small text-muted">
                                                @(r.HasOptions ? "size · sugar · toppings · " : "")@(r.TimesOrdered == 0 ? "never ordered" : "ordered " + r.TimesOrdered + "x")
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge rounded-pill text-bg-light border">@r.Category</span></td>
                                <td class="fw-semibold">$@r.Price.ToString("0.00")</td>
                                <td>
                                    @if (r.IsAvailable)
                                    {
                                        <span class="badge rounded-pill text-bg-success">On menu</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary">Hidden</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-light" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Toggle" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-light">
                                            @(r.IsAvailable ? "Hide" : "Show")
                                        </button>
                                    </form>

                                    @if (r.TimesOrdered == 0)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              data-msg="Delete @r.Name? This cannot be undone."
                                              onsubmit="return confirm(this.dataset.msg)">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-light text-muted" disabled
                                                title="Has order history. Use Hide instead.">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light text-muted small">
                Items that were already ordered cannot be deleted, because old receipts use them. Use <b>Hide</b> to take them off the order screen.
            </div>
        </div>
    </div>

    <!-- New category -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-semibold mb-3"><i class="bi bi-tags me-1"></i> New category</h5>
                <form asp-action="AddCategory" method="post">
                    <input type="text" name="categoryName" class="form-control mb-2"
                           placeholder="e.g. Tea" maxlength="50" required />
                    <button type="submit" class="btn btn-sne w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>