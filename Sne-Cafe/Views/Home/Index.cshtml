@model SneCafe.Models.OrdersViewModel
@{
    ViewData["Title"] = "Orders";
}

<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Orders</h1>
        <p class="text-muted mb-0">Track and update cafe orders.</p>
    </div>
    <a asp-controller="Order" asp-action="Create" class="btn btn-sne px-4">
        <i class="bi bi-plus-lg me-1"></i> New Order
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-clipboard-check"></i></div>
                <div>
                    <div class="text-muted small">Orders</div>
                    <div class="fs-4 fw-semibold">@Model.Orders.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="text-muted small">In Progress</div>
                    <div class="fs-4 fw-semibold">@Model.InProgress</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <div class="text-muted small">Completed</div>
                    <div class="fs-4 fw-semibold">@Model.Completed</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-currency-dollar"></i></div>
                <div>
                    <div class="text-muted small">Sales (not cancelled)</div>
                    <div class="fs-4 fw-semibold">$@Model.Sales.ToString("0.00")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table card -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="input-group" style="max-width: 360px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input id="orderSearch" type="text" class="form-control border-start-0"
                   placeholder="Search by order no, item or status..." />
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" asp-route-range="today"
               class="pill text-decoration-none @(Model.Range == "today" ? "active" : "")">Today</a>
            <a asp-action="Index" asp-route-range="all"
               class="pill text-decoration-none @(Model.Range == "all" ? "active" : "")">All</a>
        </div>
    </div>

    @if (Model.Orders.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase small text-muted">
                        <th class="ps-4">Order</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        var badge = o.Status switch
                        {
                            "Pending" => "text-bg-warning",
                            "Preparing" => "text-bg-info",
                            "Completed" => "text-bg-success",
                            _ => "text-bg-danger"
                        };

                        <tr class="order-row">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar"><i class="bi bi-cup-hot"></i></div>
                                    <div>
                                        <div class="fw-semibold">@o.OrderNo</div>
                                        <div class="text-muted small">@o.ItemsText</div>
                                        @if (!string.IsNullOrEmpty(o.Note))
                                        {
                                            <div class="small fst-italic" style="color: var(--sne-green)">
                                                <i class="bi bi-sticky"></i> @o.Note
                                            </div>
                                        }
                                        <div class="text-muted small">@o.CreatedAt.ToString("dd MMM · HH:mm")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">$@o.Total.ToString("0.00")</div>
                                <div class="text-muted small">
                                    <i class="bi @(o.PaymentMethod == "Card" ? "bi-credit-card" : "bi-cash-coin")"></i> @o.PaymentMethod
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill @badge">@o.Status</span>
                            </td>
                            <td class="text-end pe-4">

                                @if (o.Status == "Pending")
                                {
                                    <form asp-action="SetStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="status" value="Preparing" />
                                        <input type="hidden" name="range" value="@Model.Range" />
                                        <button type="submit" class="btn btn-sm btn-sne py-1 px-3">
                                            <i class="bi bi-play-fill"></i> Start
                                        </button>
                                    </form>
                                }
                                else if (o.Status == "Preparing")
                                {
                                    <form asp-action="SetStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="status" value="Completed" />
                                        <input type="hidden" name="range" value="@Model.Range" />
                                        <button type="submit" class="btn btn-sm btn-sne py-1 px-3">
                                            <i class="bi bi-check-lg"></i> Complete
                                        </button>
                                    </form>
                                }

                                <a href="/Order/Receipt/@o.Id" class="btn btn-sm btn-light" title="Receipt">
                                    <i class="bi bi-receipt"></i>
                                </a>

                                @if (o.Status == "Pending" || o.Status == "Preparing")
                                {
                                    <form asp-action="SetStatus" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel order @o.OrderNo?');">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <input type="hidden" name="range" value="@Model.Range" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Cancel order">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="noResults" class="d-none text-center text-muted py-5">
            No orders match your search.
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="display-5 text-muted mb-2"><i class="bi bi-cup-hot"></i></div>
            <h5 class="fw-semibold">No orders yet</h5>
            <p class="text-muted">Take your first order to get started.</p>
            <a asp-controller="Order" asp-action="Create" class="btn btn-sne">New Order</a>
        </div>
    }

    <div class="card-footer bg-light text-muted small">
        Showing <span id="visibleCount">@Model.Orders.Count</span> of @Model.Orders.Count orders
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('orderSearch');
        const rows = document.querySelectorAll('.order-row');
        const noResults = document.getElementById('noResults');
        const visibleCount = document.getElementById('visibleCount');

        searchInput?.addEventListener('input', () => {
            const q = searchInput.value.toLowerCase().trim();
            let shown = 0;

            rows.forEach(row => {
                const match = row.innerText.toLowerCase().includes(q);
                row.classList.toggle('d-none', !match);
                if (match) shown++;
            });

            visibleCount.textContent = shown;
            noResults?.classList.toggle('d-none', shown > 0);
        });
    </script>
}